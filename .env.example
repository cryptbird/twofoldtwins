# Copy to .env.local (for `vercel dev`) and set the same values in the Vercel
# project settings -> Environment Variables, otherwise /api/send-email returns
# "Email is not configured on the server yet".

# Gmail account that sends the contact-form mail.
EMAIL_USER=khushvardhanbhardwaj@gmail.com

# A Gmail App Password (16 chars, no spaces) for the account above.
# Generate at https://myaccount.google.com/apppasswords (requires 2FA enabled).
# This is NOT the Google account password.
EMAIL_APP_PASSWORD=

# Optional recipient overrides.
# CONTACT_TO_KHUSH=khushvardhanbhardwaj@gmail.com
# CONTACT_TO_TWOFOLDTWINS=twofoldtwins.inc@gmail.com
